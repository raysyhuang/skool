# Skool Environment Configuration
# Copy this file to .env and update values for your deployment

# Security (REQUIRED for production)
SECRET_KEY=change-me-in-production
# Generate with: openssl rand -hex 32

# Database
DATABASE_URL=sqlite:///./skool.db
# For PostgreSQL: postgresql://user:password@localhost:5432/skool
# Heroku automatically sets DATABASE_URL

# Development
DEBUG=False
# Set to True for local development (disables HTTPS-only cookies and HSTS)

# Game Rules (optional overrides)
MAX_SESSIONS_PER_DAY=2
# Set to 0 for unlimited sessions (useful for testing)

# QUESTIONS_PER_SESSION=5
# DISTRACTORS_PER_QUESTION=2
